{
  "name": "serialterminal",
  "displayName": "serial terminal",
  "publisher": "awsxxf",
  "version": "0.1.6",
  "description": "An interactive serial terminal tool",
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/littrick/vscode-serial-terminal.git"
  },
  "homepage": "https://github.com/littrick/vscode-serial-terminal/blob/main/README.md",
  "bugs": {
    "url": "https://github.com/littrick/vscode-serial-terminal/issues"
  },
  "icon": "assets/logo.png",
  "l10n": "./l10n",
  "keywords": [
    "serial port",
    "serial",
    "com",
    "terminal",
    "console",
    "uart"
  ],
  "pricing": "Free",
  "engines": {
    "vscode": "^1.76.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionPack": [
    "awsxxf.scriptnotebook"
  ],
  "extensionDependencies": [
    "awsxxf.scriptnotebook"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "entryView",
          "title": "%entryView.title%",
          "icon": "$(debug-disconnect)"
        }
      ]
    },
    "views": {
      "entryView": [
        {
          "icon": "$(plug)",
          "name": "%TreeView.serialPorts%",
          "id": "serialport.serialportView",
          "initialSize": 20
        },
        {
          "icon": "$(output)",
          "name": "%TreeView.logs%",
          "id": "serialport.logs",
          "initialSize": 30
        },
        {
          "icon": "$(notebook)",
          "name": "%TreeView.scriptsNotebooks%",
          "id": "serialport.scriptsNotebooks"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "serialPortTerminal",
          "title": "%serialPortTerminal%"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "serialTerminal.serialView.openCustom",
          "when": "view == serialport.serialportView",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminal.refresh",
          "when": "view == serialport.serialportView",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminal.setting.SerialPort",
          "when": "view == serialport.serialportView",
          "group": "navigation@3"
        },
        {
          "command": "serialTerminal.logView.newFolder",
          "when": "view == serialport.logs",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminal.refresh",
          "when": "view == serialport.logs",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminal.logView.revealLogs",
          "when": "view == serialport.logs",
          "group": "navigation@3"
        },
        {
          "command": "serialTerminal.setting.Log",
          "when": "view == serialport.logs",
          "group": "navigation@4"
        },
        {
          "command": "serialTerminal.scriptView.newNotebook",
          "when": "view == serialport.scriptsNotebooks",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminal.scriptView.newFolder",
          "when": "view == serialport.scriptsNotebooks",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminal.refresh",
          "when": "view == serialport.scriptsNotebooks",
          "group": "navigation@3"
        },
        {
          "command": "serialTerminal.scriptView.revealNotebooks",
          "when": "view == serialport.scriptsNotebooks",
          "group": "navigation@4"
        },
        {
          "command": "serialTerminal.setting.Notebook",
          "when": "view == serialport.scriptsNotebooks",
          "group": "navigation@5"
        },
        {
          "command": "serialTerminal.terminal.startSaveLog",
          "when": "view == terminal && serialTerminal.terminal.focus && !serialTerminal.terminal.recordingLog",
          "group": "navigation"
        },
        {
          "command": "serialTerminal.terminal.stopSaveLog",
          "when": "view == terminal && serialTerminal.terminal.focus && serialTerminal.terminal.recordingLog",
          "group": "navigation"
        },
        {
          "command": "serialTerminal.terminal.clear",
          "when": "view == terminal",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "serialTerminal.serialView.open",
          "when": "view == serialport.serialportView",
          "group": "inline"
        },
        {
          "command": "serialTerminal.treeItem.openOnEditor",
          "when": "view == serialport.logs && viewItem == logFile",
          "group": "inline@1"
        },
        {
          "command": "serialTerminal.treeItem.deleteResource",
          "when": "view == serialport.logs && viewItem == logFile",
          "group": "inline@2"
        },
        {
          "command": "serialTerminal.treeItem.openOnEditor",
          "when": "view == serialport.logs && viewItem == logFile",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminal.treeItem.renameResource",
          "when": "view == serialport.logs && viewItem =~ /^log(File|Folder)$/",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminal.treeItem.copyPath",
          "when": "view == serialport.logs && viewItem =~ /^log(File|Folder)$/",
          "group": "navigation@3"
        },
        {
          "command": "serialTerminal.treeItem.revealInExplorer",
          "when": "view == serialport.logs && viewItem =~ /^log(File|Folder)$/",
          "group": "navigation@4"
        },
        {
          "command": "serialTerminal.treeItem.deleteResource",
          "when": "view == serialport.logs && viewItem =~ /^log(File|Folder)$/",
          "group": "z_delete"
        },
        {
          "command": "serialTerminal.treeItem.openOnEditor",
          "when": "view == serialport.scriptsNotebooks && viewItem == scriptFile",
          "group": "inline@1"
        },
        {
          "command": "serialTerminal.treeItem.deleteResource",
          "when": "view == serialport.scriptsNotebooks && viewItem == scriptFile",
          "group": "inline@2"
        },
        {
          "command": "serialTerminal.treeItem.openOnEditor",
          "when": "view == serialport.scriptsNotebooks && viewItem == scriptFile",
          "group": "navigation@1"
        },
        {
          "command": "serialTerminal.treeItem.renameResource",
          "when": "view == serialport.scriptsNotebooks && viewItem =~ /^script(File|Folder)$/",
          "group": "navigation@2"
        },
        {
          "command": "serialTerminal.treeItem.revealInExplorer",
          "when": "view == serialport.scriptsNotebooks && viewItem =~ /^script(File|Folder)$/",
          "group": "navigation@3"
        },
        {
          "command": "serialTerminal.treeItem.deleteResource",
          "when": "view == serialport.scriptsNotebooks && viewItem =~ /^script(File|Folder)$/",
          "group": "z_delete"
        }
      ]
    },
    "commands": [
      {
        "command": "serialTerminal.terminal.startSaveLog",
        "icon": "$(save-as)",
        "title": "%commands.terminal.startSaveLog%"
      },
      {
        "command": "serialTerminal.terminal.stopSaveLog",
        "icon": "$(stop-circle)",
        "title": "%commands.terminal.stopSaveLog%"
      },
      {
        "command": "serialTerminal.terminal.clear",
        "icon": "$(clear-all)",
        "title": "%commands.terminal.clear%"
      },
      {
        "command": "serialTerminal.setting.SerialPort",
        "icon": "$(gear)",
        "title": "%commands.setting.SerialPort%"
      },
      {
        "command": "serialTerminal.setting.Log",
        "icon": "$(gear)",
        "title": "%commands.setting.Log%"
      },
      {
        "command": "serialTerminal.setting.Notebook",
        "icon": "$(gear)",
        "title": "%commands.setting.Notebook%"
      },
      {
        "icon": "$(arrow-right)",
        "command": "serialTerminal.treeItem.openOnEditor",
        "title": "%commands.treeItem.openOnEditor%"
      },
      {
        "command": "serialTerminal.treeItem.revealInExplorer",
        "icon": "$(file-directory)",
        "title": "%commands.treeItem.revealInExplorer%"
      },
      {
        "command": "serialTerminal.treeItem.copyPath",
        "icon": "$(copy)",
        "title": "%commands.treeItem.copyPath%"
      },
      {
        "command": "serialTerminal.treeItem.renameResource",
        "icon": "$(edit)",
        "title": "%commands.treeItem.renameResource%"
      },
      {
        "command": "serialTerminal.treeItem.deleteResource",
        "icon": "$(trash)",
        "title": "%commands.treeItem.deleteResource%"
      },
      {
        "command": "serialTerminal.serialView.open",
        "icon": "$(arrow-right)",
        "title": "%commands.serialView.open%"
      },
      {
        "command": "serialTerminal.serialView.openCustom",
        "icon": "$(add)",
        "title": "%commands.serialView.openCustom%"
      },
      {
        "command": "serialTerminal.refresh",
        "icon": "$(refresh)",
        "title": "%commands.refresh%"
      },
      {
        "command": "serialTerminal.logView.revealLogs",
        "icon": "$(file-directory)",
        "title": "%commands.logView.revealLogs%"
      },
      {
        "command": "serialTerminal.logView.newFolder",
        "icon": "$(new-folder)",
        "title": "%commands.logView.newFolder%"
      },
      {
        "command": "serialTerminal.scriptView.newNotebook",
        "icon": "$(new-file)",
        "title": "%commands.scriptView.newNotebook%"
      },
      {
        "command": "serialTerminal.scriptView.newFolder",
        "icon": "$(new-folder)",
        "title": "%commands.scriptView.newFolder%"
      },
      {
        "command": "serialTerminal.scriptView.revealNotebooks",
        "icon": "$(file-directory)",
        "title": "%commands.scriptView.revealNotebooks%"
      }
    ],
    "configuration": {
      "title": "%setting.title%",
      "properties": {
        "SerialTerminal.serialPort.configurations": {
          "title": "%setting.serialPort.configurations.title%",
          "type": "array",
          "default": [
            "115200n1",
            "9600n1",
            "19200n1",
            "38400n1",
            "76800n1",
            "153600n1",
            "460800n1",
            "921600n1",
            "2000000n1"
          ],
          "items": {
            "type": "string",
            "pattern": "^(\\d+)((n|e|o)([5678])?(1|1.5|2)?)?$"
          },
          "markdownDescription": "%setting.serialPort.configurations.description%"
        },
        "SerialTerminal.serialPort.autoRefresh": {
          "title": "%setting.serialPort.autoRefresh.title%",
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.serialPort.autoRefresh.description%"
        },
        "SerialTerminal.serialPort.autoRefreshInterval": {
          "title": "%setting.serialPort.autoRefreshInterval.title%",
          "type": "number",
          "default": 2000,
          "minimum": 500,
          "markdownDescription": "%setting.serialPort.autoRefreshInterval.description%"
        },
        "SerialTerminal.serialPort.autoReconnect": {
          "title": "%setting.serialPort.autoReconnect.title%",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.serialPort.autoReconnect.description%"
        },
        "SerialTerminal.log.savePath": {
          "title": "%setting.log.savePath.title%",
          "type": "string",
          "markdownDescription": "%setting.log.savePath.description%"
        },
        "SerialTerminal.log.autoSave": {
          "title": "%setting.log.autoSave.title%",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.log.autoSave.description%"
        },
        "SerialTerminal.log.timestamp.enable": {
          "title": "%setting.log.timestamp.enable.title%",
          "type": "boolean",
          "default": false,
          "markdownDescription": "%setting.log.timestamp.enable.description%"
        },
        "SerialTerminal.log.timestamp.duration": {
          "title": "%setting.log.timestamp.duration.title%",
          "type": "number",
          "default": 20000000,
          "markdownDescription": "%setting.log.timestamp.duration.description%"
        },
        "SerialTerminal.log.filterSpecialChars": {
          "title": "%setting.log.filterSpecialChars.title%",
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.log.filterSpecialChars.description%"
        },
        "SerialTerminal.notebook.savePath": {
          "title": "%setting.notebook.savePath.title%",
          "type": "string",
          "markdownDescription": "%setting.notebook.savePath.description%"
        },
        "SerialTerminal.notebook.openMdAsNotebook": {
          "title": "%setting.notebook.openMdAsNotebook.title%",
          "type": "boolean",
          "default": true,
          "markdownDescription": "%setting.notebook.openMdAsNotebook.description%"
        },
        "SerialTerminal.notebook.newNotebookFormat": {
          "title": "%setting.notebook.newNotebookFormat.title%",
          "type": "string",
          "enum": [
            "mdnb",
            "md"
          ],
          "enumDescriptions": [
            "%setting.notebook.newNotebookFormat.mdnb%",
            "%setting.notebook.newNotebookFormat.md%"
          ],
          "default": "mdnb",
          "markdownDescription": "%setting.notebook.newNotebookFormat.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "1.76.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vscode/l10n-dev": "^0.0.26",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^8.57.1",
    "glob": "^8.1.0",
    "mocha": "^10.8.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "colors": "^1.4.0",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "serialport": {
      "@serialport/bindings-cpp": "npm:@littrick/serialport-bindings-cpp@1.0.1"
    }
  }
}