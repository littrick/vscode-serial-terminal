.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts

# vsce 默认忽略所有 *.vsix，这里只放行 bundled/ 下的依赖扩展包
!bundled/**/*.vsix

# 子模块源码不打包
submodules/**
.gitmodules

# 原生绑定的构建期文件不打包（运行时使用 prebuilds 中的二进制）
node_modules/node-addon-api/**
node_modules/serialport/node_modules/@serialport/bindings-cpp/src/**
node_modules/serialport/node_modules/@serialport/bindings-cpp/binding.gyp

# 桌面版 VS Code 用不到的 Android 预编译二进制
node_modules/serialport/node_modules/@serialport/bindings-cpp/prebuilds/android-*/**
